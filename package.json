{
  "name": "cubear",
  "version": "1.0.0",
  "description": "CubeAR — Smart AR Rubik’s Cube Solver (camera scanning, Kociemba solving, AR guidance)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "vitest run tests/fixtures/export.test.ts",
    "postinstall": "node scripts/copy-opencv.mjs",
    "predev": "node scripts/copy-opencv.mjs",
    "prebuild": "node scripts/copy-opencv.mjs",
    "pretest:e2e": "npm run fixtures"
  },
  "author": "Viknan S",
  "license": "MIT",
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "cubejs": "^1.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
